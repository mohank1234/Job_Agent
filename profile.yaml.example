# EXAMPLE / TEMPLATE — copy this to profile.yaml and replace every value
# below with your own. profile.yaml is gitignored (it's your real career
# history), so a fresh checkout has none until you create one from this file
# (repo audit 2026-09-07 finding #11).
#
#     cp profile.yaml.example profile.yaml
#
# The `target_roles` and `skills` sections below are a generic QA/test/AI-
# eval title taxonomy, not personal data — keep or trim them, they're meant
# to be reused. `identity` and the company lists under `preferences` ARE
# personal and are shown here only as placeholders — replace them.
#
# =============================================================================
# CENTRAL CAREER PROFILE
# =============================================================================
# This is the single source of truth for who the candidate is and what roles
# are worth applying for. jobagent/profile.py loads it; roles.py and matcher.py
# read it. Nothing about the candidate is hardcoded in Python.
#
# Edit this file to retune the agent. Do not duplicate any of it in code.
# =============================================================================

identity:
  headline: "PLACEHOLDER — e.g. 'Software QA Engineer' or 'Backend Developer'"

  # Experience is a FLEXIBLE matching factor, never a hard filter.
  # `years` describes reality; `stretch_years` is how far above that a stated
  # requirement can go before the match is materially penalised.
  experience:
    years: 0                  # PLACEHOLDER — your real years of experience
    level: mid_senior          # see seniority.self_level below
    stretch_years: 3           # a 5-yr profile still competes for ~8-yr asks
    hard_gap_years: 6          # beyond this the gap is genuinely large

  # Free text the LLM reasons over. Keep it honest — it is scored against
  # reality, and inventing experience produces useless matches.
  summary: |
    PLACEHOLDER — replace with your own honest summary of experience, core
    skills, and what you do NOT claim. This is what the LLM reasons over when
    scoring a posting against you, so specificity here directly improves
    match quality. See README.md for the shape this section should take.

# -----------------------------------------------------------------------------
# TARGET ROLES — roles are the primary discovery signal, not technologies.
# Tier 1 = core target. Tier 2 = strong adjacent. Tier 3 = consider when the
# actual responsibilities overlap. Titles here are examples; roles.py matches
# semantically-equivalent variants, it does not string-compare this list.
# -----------------------------------------------------------------------------
target_roles:
  tier_1:
    core_qa:
      - Senior QA Engineer
      - QA Engineer
      - Senior Software QA Engineer
      - Software QA Engineer
      - Senior Software Test Engineer
      - Software Test Engineer
      - Senior Test Engineer
      - Test Engineer
      - Quality Engineer
      - Senior Quality Engineer
      - Software Quality Engineer
      - Quality Assurance Engineer
      - Senior Quality Assurance Engineer
      - QA Analyst
      - Test Analyst

    automation_sdet:
