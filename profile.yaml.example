      - SDET
      - Software Development Engineer in Test
      - Senior QA Automation Engineer
      - QA Automation Engineer
      - Senior Test Automation Engineer
      - Test Automation Engineer
      - Automation Test Engineer
      - Automation QA Engineer
      - QA Engineer - Automation
      - Quality Engineer - Automation

    ai_llm_qa:
      - AI QA Engineer
      - AI Test Engineer
      - AI Quality Engineer
      - AI Evaluation Engineer
      - AI Validation Engineer
      - AI Application Test Engineer
      - AI/ML Test Engineer
      - LLM QA Engineer
      - LLM Test Engineer
      - LLM Evaluation Engineer
      - LLM Quality Engineer
      - GenAI QA Engineer
      - GenAI Test Engineer
      - Generative AI QA Engineer
      - Generative AI Test Engineer
      - AI Model Evaluation Engineer
      - AI Model Validation Engineer

  tier_2:
    rag_agents:
      - RAG QA Engineer
      - RAG Test Engineer
      - RAG Evaluation Engineer
      - RAG Quality Engineer
      - AI Agent QA Engineer
      - AI Agent Test Engineer
      - AI Agent Evaluation Engineer
      - Agentic AI Test Engineer
      - Agentic AI QA Engineer
      - AI Workflow Test Engineer
      - AI Copilot QA Engineer
      - AI Copilot Test Engineer

    conversational_ai:
      - Chatbot QA Engineer
      - Chatbot Test Engineer
      - Conversational AI QA Engineer
      - Conversational AI Test Engineer
      - Conversational AI Quality Engineer
      - AI Assistant QA Engineer
      - Virtual Assistant Test Engineer
      - Conversational Agent Test Engineer

    computer_vision:
      - Computer Vision QA Engineer
      - Computer Vision Test Engineer
      - Computer Vision Quality Engineer
      - Vision Model Evaluation Engineer
      - Vision Model Validation Engineer
      - ML Model Test Engineer
      - ML Model Evaluation Engineer

    swe_quality:
      - Software Engineer in Test
      - Software Engineer - Test
      - Software Engineer - QA
      - Software Engineer - Quality
      - Software Engineer - Automation
      - Software Engineer - Test Automation
      - Software Engineer - Quality Engineering
      - Software Engineer - Developer Productivity
      - Test Infrastructure Engineer
      - Test Platform Engineer

  # Tier 3 roles only qualify when the ACTUAL responsibilities overlap with the
  # profile (testing, quality, evaluation, automation, API validation).
  tier_3:
    swe_ai:
      - Software Engineer - AI Testing
      - Software Engineer - AI Quality
      - Software Engineer - AI Evaluation
      - Software Engineer - LLM
      - Software Engineer - GenAI
      - Software Engineer - AI Applications
      - Software Engineer - AI Agents
      - Software Engineer - RAG
    swe_generic:
      - Software Engineer
      - Software Developer
      - Backend Engineer

