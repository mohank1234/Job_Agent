# -----------------------------------------------------------------------------
# SENIORITY — flexible. One reasonable level above the current level is fine
# when the responsibilities and technical requirements match strongly.
# -----------------------------------------------------------------------------
seniority:
  self_level: mid_senior            # junior < mid < mid_senior < senior < staff
  acceptable:
    - junior                        # accepted but scored down (backwards step)
    - mid
    - mid_senior
    - senior
    - lead                          # tech lead: consider, penalise modestly
    - staff                         # stretch: consider only on strong match
  reject:                           # substantially beyond the current level
    - principal
    - architect
    - manager
    - director
    - head
    - vp
    - executive

# -----------------------------------------------------------------------------
# PREFERENCES — location / work mode. These affect the SCORE, they do not
# delete jobs from the database.
# -----------------------------------------------------------------------------
preferences:
  # Pay is shown when published, but never filters/ranks the daily search.
  compensation_filter_enabled: false
  home_country: India        # residence; distinct from the search markets below
  # Global search. Remote roles anywhere are in scope; onsite roles are in
  # scope in these markets. Locations affect the SCORE, never storage.
  locations:
    # India — home market, no visa needed
    - india
    - bengaluru
    - bangalore
    - hyderabad
    - pune
    - chennai
    - mumbai
    - delhi
    - noida
    - gurgaon
    - gurugram
    # United States
    - united states
    - usa
    - "u.s."
    - new york
    - san francisco
    - seattle
    - austin
    - boston
    - chicago
    - atlanta
    - denver
    - texas
    - california
    # United Kingdom / Ireland
    - united kingdom
    - " uk"
    - england
    - london
    - manchester
    - edinburgh
    - dublin
    - ireland
    # Saudi Arabia and the Gulf
    - saudi
    - saudi arabia
    - riyadh
    - jeddah
    - dammam
    - neom
    - uae
    - united arab emirates
    - dubai
    - abu dhabi
    - sharjah
    - qatar
    - doha
    - kuwait
    - bahrain
    - manama
    - oman
    - muscat
    # Wider Arab world
    - egypt
    - cairo
    - jordan
    - amman
    - lebanon
    - morocco
    - tunisia
    # Other markets worth onsite/hybrid consideration
    - singapore
    - canada
    - toronto
    - australia
    - sydney
    - germany
    - berlin
    - netherlands
    - amsterdam
    - poland
    - portugal
    - lisbon
    - spain
    # Remote anywhere
    - remote
    - anywhere
    - worldwide
    - global

  # ---------------------------------------------------------------------
  # WORK-LOCATION POLICY
  #   Remote      -> anywhere. India-based or foreign employer, both fine.
  #   Onsite/hybrid -> INDIA ONLY, and only in the cities below.
  #                    No onsite or hybrid role outside India at any salary.
  # ---------------------------------------------------------------------
  # STRICT: only postings whose TITLE names a QA / testing / evaluation role.
  # Developer roles are excluded even when their description is full of
  # testing words.
  qa_roles_only: true

  remote_preference: strong          # none | mild | strong
  remote_scope: anywhere             # remote for a foreign employer is fine
  workplace_ok: [remote, hybrid, onsite, unknown]

  # Onsite/hybrid is HYDERABAD in India. Singapore is the one place abroad
  # that is in scope, and only when the employer can actually sponsor an
  # Employment Pass — see the singapore block below. Anywhere else, in India
  # or abroad, is out however good the role is.
  onsite_cities:
    # PLACEHOLDER — your acceptable onsite/hybrid cities, ranked groups
    # (first group = most preferred). Whatever you list here is what the
    # matcher and the LLM prompt (Profile.geography_rule) actually enforce.
    - [your-city]

  onsite_abroad: false               # or e.g. "singapore_only" — see below
  relocation: none                   # PLACEHOLDER — your real relocation policy

  # ---------------------------------------------------------------------
  # SINGAPORE / EMPLOYMENT PASS
  # A Singapore onsite role is only real if the employer can sponsor an
  # Employment Pass. The EP has a hard salary floor set by MOM, so the
  # advertised salary decides eligibility as a matter of law, not opinion.
  # Figures are the 2026 floors for the youngest applicants and rise with
  # age; from 1 Jan 2027 the general floor becomes 6000.
  # Source: MOM. Re-check yearly - these change every January.
  # ---------------------------------------------------------------------
  singapore:
    ep_min_monthly_sgd: 5600         # most sectors, 2026
    ep_min_monthly_sgd_finance: 6200 # financial services, 2026
    # Salary at or above the floor means an EP is legally possible. Below it,
    # the employer cannot sponsor you whatever the posting says.
    treat_below_floor_as_ineligible: true

  visa_note: >
    PLACEHOLDER — replace with your own work-authorization situation: your
    home country, which remote arrangements you can actually accept, and any
    onsite/hybrid locations where you'd need visa sponsorship (see the
    `singapore` block above for how one country's sponsorship rule is
    modeled — copy that pattern for any other country you need).

  # ---------------------------------------------------------------------
  # EMPLOYER QUALITY
  # Product companies that pay 30+ LPA in India. A posting from one of these
  # is worth more than the same role at a staffing firm, so they get a score
  # bonus. Matching is on the company name, case-insensitive, word-anchored.
  # ---------------------------------------------------------------------
  preferred_companies:
    # PLACEHOLDER — companies you specifically want a score bonus for, even
    # with no ATS board tracked (see companies.yaml for boards that ARE
    # polled). Matching is on the company name, case-insensitive,
    # word-anchored. This list grows over time as you research companies —
    # a few examples to show the format:
    - example-company-one
    - example-company-two
    - example-company-three

  # Staffing / recruitment firms whose names carry no obvious marker. Generic
  # markers (consultancy, manpower, staffing, recruitment...) are detected in
  # roles.py; this list is for the ones you can only know by name. Add to it
  # whenever a middleman shows up in your digest.
  staffing_companies:
    - allegis
    - nityo
    - randstad
    - adecco
    - manpowergroup
    - kelly services
    - hays
    - robert half
    - collabera
    - teksystems
    - insight global
    - apex systems
    - artech
    - diverse lynx
    - mastech
    - sysmind
    - photon
    - iris software
    - v-soft
    - infojini
    - kforce
    - judge group
    - michael page
    - abc consultants
    - careernet
    - xpheno
    - quess
    - teamlease
    - aaksar
    - sketchhr
    - sequoia connect

  # Score bonus for a preferred employer, penalty for a staffing agency.
  preferred_company_bonus: 12
  staffing_agency_penalty: 14

  # Compensation context for the LLM's judgement. Rarely stated in postings,
  # so it informs the recommendation — it is never a filter.
  current_ctc_lpa: 0                 # PLACEHOLDER — your real current comp
  min_ctc_lpa: 0                     # PLACEHOLDER — will not move for less
  target_ctc_lpa: 0                  # PLACEHOLDER — top of your realistic range

